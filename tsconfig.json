{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*",
    "client/**/*",
    "revideo/**/*",
    "shared/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "scripts/**",
    "node_modules",
    "dist"
  ]
}

