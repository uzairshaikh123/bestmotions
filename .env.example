PORT=3001
HOST=0.0.0.0

# Frontend → backend base URL (required for the client)
# Local:
VITE_API_BASE=http://localhost:3001
# Vercel → Render:
# VITE_API_BASE=https://bestmotions.onrender.com

# Export timeout in ms (default 180000 = 3 minutes)
RENDER_TIMEOUT_MS=180000
VITE_RENDER_TIMEOUT_MS=180000

# Video sound feature (default off — Sound UI hidden; preview/export forced silent)
# Frontend (Vite): restart `npm run dev:client` after changing
VITE_FEATURE_VIDEO_SOUND=false
# Backend export enforcement (and /api/feature-flags when VITE_ is unset)
FEATURE_VIDEO_SOUND=false
