PORT=3001
HOST=0.0.0.0

# Frontend → backend base URL (required for the client)
# Local:
VITE_API_BASE=http://localhost:3001
# Vercel → Render:
# VITE_API_BASE=https://bestmotions.onrender.com

# Export timeout in ms (default 180000 = 3 minutes)
RENDER_TIMEOUT_MS=180000
VITE_RENDER_TIMEOUT_MS=180000

# Video sound feature (default off — Sound UI hidden; preview/export forced silent)
# Frontend (Vite): restart `npm run dev:client` after changing
VITE_FEATURE_VIDEO_SOUND=false
# Backend export enforcement (and /api/feature-flags when VITE_ is unset)
FEATURE_VIDEO_SOUND=false

# Magic Board editor. false/unset = Coming soon overlay. true = unlock the real editor.
# Restart `npm run dev:client` (or rebuild) after changing.
VITE_FEATURE_BOARD=false

# Prompt-to-video AI (Gemini). FEATURE_AI alone controls Coming soon vs real UI for all clients.
# Restart the server after changing; clients pick it up from /api/feature-flags.
FEATURE_AI=false
GEMINI_API_KEY=
# Optional override (default gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Real map templates fetch Esri basemap imagery through /api/map-image (no API key).
# Requires the backend running so satellite/street/topo previews can load.

# Google Analytics 4 — Measurement ID (e.g. G-XXXXXXXXXX). Empty/unset = analytics off.
# Set in Vercel/hosting env for production (Vite bakes VITE_* at build time).
# VITE_GA_MEASUREMENT_ID=
